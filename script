# 9. REACT COMMAND PARSER (FOOLPROOF EXECUTION)
# ==============================================================================
def parse_and_execute_ai_commands(ai_raw_output, engine, state_batch):
    """Intercepts AI commands, executes them in Python, and returns clean narrative."""
    narrative = ai_raw_output
    system_feedback = []

    # 1. Handle [CALCULATE: ...]
    for match in re.findall(r'\[CALCULATE:\s*(.*?)\]', narrative, re.IGNORECASE):
        result = engine.calculate(match)
        narrative = narrative.replace(f"[CALCULATE: {match}]", f"**[System: Calculated {match} = {result}]**")
        system_feedback.append(f"🧮 Calc: {match} = {result}")

    # 2. Handle [ROLL: ...]
    for match in re.findall(r'\[ROLL:\s*(.*?)\]', narrative, re.IGNORECASE):
        try:
            parts = match.split('+')
            dice_part, mod_part = parts[0].strip(), parts[1].strip() if len(parts) > 1 else "0"
            num, sides = map(int, dice_part.split('d')) if 'd' in dice_part else (1, int(dice_part))
            roll_val = sum(random.randint(1, sides) for _ in range(num))
            mod_val = engine.get_var(mod_part) if not mod_part.replace('.','').isdigit() else float(mod_part)
            total = roll_val + mod_val
            narrative = narrative.replace(f"[ROLL: {match}]", f"**[System: Rolled {match} = {total} (Roll: {roll_val} + Mod: {mod_val})]**")
            system_feedback.append(f"🎲 Roll: {match} = {total}")
        except Exception as e:
            narrative = narrative.replace(f"[ROLL: {match}]", f"**[System Error: Invalid roll '{match}']**")

    # 3. Handle [CHECK_RESOURCE: item: amount]
    for match in re.findall(r'\[CHECK_RESOURCE:\s*(\w+):\s*(\d+)\]', narrative, re.IGNORECASE):
        item, amount = match
        current = engine.get_var(f'player.resources.{item}')
        status = "✅ SUFFICIENT" if current >= int(amount) else "❌ INSUFFICIENT"
        narrative = narrative.replace(f"[CHECK_RESOURCE: {item}: {amount}]", f"**[System: Resource '{item}' ({amount}) = {status}]**")
        system_feedback.append(f"🎒 Resource: {item} ({amount}) = {status}")

    # 4. Handle [STATE_UPDATE: {...}]
    for match in re.findall(r'\[STATE_UPDATE:\s*(\{.*?\})\]', narrative, re.IGNORECASE):
        try:
            update_dict = eval(match)
            for path, value in update_dict.items():
                state_batch.update(path, value)
            narrative = narrative.replace(f"[STATE_UPDATE: {match}]", "**[System: State Updated]**")
        except Exception:
            narrative = narrative.replace(f"[STATE_UPDATE: {match}]", "**[System Error: Invalid State Update]**")

    # 5. Handle [ARCHIVE: code, priority, summary]
    for match in re.findall(r'\[ARCHIVE:\s*(.*?),\s*(.*?),\s*(.*?)\]', narrative, re.IGNORECASE):
        code, priority, summary = [x.strip() for x in match]
        archive_to_memory_bank(code, {"action": "archived"}, summary, priority)
        narrative = narrative.replace(f"[ARCHIVE: {match[0]}, {match[1]}, {match[2]}]", "**[System: Archived to Memory Bank]**")

    return narrative, system_feedback

