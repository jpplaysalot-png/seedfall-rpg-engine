def parse_and_execute_ai_commands(ai_raw_output, engine, state_batch):
    narrative = ai_raw_output
    system_feedback = []

    # 1. [CALCULATE: ...]
    for match in re.findall(r'\[CALCULATE:\s*(.*?)\]', narrative, re.IGNORECASE):
        result = engine.calculate(match)
        narrative = narrative.replace(f"[CALCULATE: {match}]", f"**[System: {match} = {result}]**")
        system_feedback.append(f"🧮 {match} = {result}")

    # 2. [ROLL: ...]
    for match in re.findall(r'\[ROLL:\s*(.*?)\]', narrative, re.IGNORECASE):
        try:
            dice_match = re.match(r'(\d+d\d+)', match.strip())
            if dice_match:
                dice_part = dice_match.group(1)
                num, sides = map(int, dice_part.split('d'))
                roll_val = sum(random.randint(1, sides) for _ in range(num))
            else:
                roll_val = 0
                dice_part = ""

            mod_str = match.strip()[len(dice_part):].strip() if dice_part else match.strip()
            mod_val = 0
            if mod_str:
                try:
                    mod_val = engine.calculate(mod_str)
                except Exception:
                    mod_val = 0

            total = roll_val + mod_val
            narrative = narrative.replace(f"[ROLL: {match}]", f"**[System: Rolled {total} ({roll_val}{'+' if mod_val>=0 else ''}{int(mod_val)})]**")
            system_feedback.append(f"🎲 {match} = {total}")
        except Exception:
            narrative = narrative.replace(f"[ROLL: {match}]", "**[System: Invalid roll]**")

    # 3. [CHECK_RESOURCE: ...] (Uses FIX #4)
    for match in re.findall(r'\[CHECK_RESOURCE:\s*(\w+):\s*(\d+)\]', narrative, re.IGNORECASE):
        item, amount = match
        current = engine.check_inventory(item)
        status = "✅ SUFFICIENT" if current >= int(amount) else "❌ INSUFFICIENT"
        narrative = narrative.replace(f"[CHECK_RESOURCE: {item}: {amount}]", f"**[System: '{item}' ({amount}) = {status}]**")
        system_feedback.append(f"🎒 {item} ({amount}) = {status}")

    # 4. [STATE_UPDATE: ...] (Your improved brace-counting regex)
    update_pattern = r'\[STATE_UPDATE:\s*'
    for m in re.finditer(update_pattern, narrative, re.IGNORECASE):
        start = m.end()
        brace_count = 0
        end = start
        for i in range(start, len(narrative)):
            if narrative[i] == '{':
                brace_count += 1
            elif narrative[i] == '}':
                brace_count -= 1
                if brace_count == 0:
                    end = i + 1
                    break
        if end > start:
            json_str = narrative[start:end]
            try:
                update_dict = json.loads(json_str)
                for path, value in update_dict.items():
                    state_batch.update(path, value)
                full_match = narrative[m.start():end + 1]
                narrative = narrative.replace(full_match, "**[System: State Updated]**")
            except json.JSONDecodeError:
                full_match = narrative[m.start():end + 1]
                narrative = narrative.replace(full_match, "**[System: Invalid Update]**")

    # 5. [ARCHIVE: ...]
    for match in re.findall(r'\[ARCHIVE:\s*(.*?),\s*(.*?),\s*(.*?)\]', narrative, re.IGNORECASE):
        code, priority, summary = [x.strip() for x in match]
        archive_to_memory_bank(code, {"action": "archived"}, summary, priority)
        narrative = narrative.replace(f"[ARCHIVE: {match[0]}, {match[1]}, {match[2]}]", "**[System: Archived]**")

    return narrative, system_feedback

