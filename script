def passive_vitals_drain(state):
    """Automatically drain hunger/thirst based on time passed."""
    turn = state['game_state']['time_tracking']['turn']
    
    if turn > 0 and turn % PASSIVE_DRAIN_INTERVAL == 0:
        player = state['game_state']['player']
        # Drain 2 hunger, 3 thirst per interval
        player['vitals']['hunger'] = max(0, player['vitals']['hunger'] - 2)
        player['vitals']['thirst'] = max(0, player['vitals']['thirst'] - 3)
        
        # Apply sanity drain in high ELQ
        if player['current_elq'] >= 15:
            player['vitals']['sanity'] = max(0, player['vitals']['sanity'] - 1)
        
        logger.info(f"⏳ Passive drain applied. Hunger: {player['vitals']['hunger']}, Thirst: {player['vitals']['thirst']}")
        return True
    return False

def force_autosave(state, reason="periodic"):
    """Force a save to JSONBin regardless of AI commands."""
    try:
        # Increment turn counter
        state['game_state']['time_tracking']['turn'] += 1
        
        # Apply passive drain
        passive_vitals_drain(state)
        
        # Save to JSONBin
        if save_game_state(state):
            logger.info(f"💾 Autosave successful ({reason})")
            return True
        return False
    except Exception as e:
        logger.error(f"Autosave failed: {e}")
        return False

def save_on_exit(state):
    """Final save when player quits."""
    print("\n💾 Saving final state before exit...")
    if save_game_state(state):
        print("✅ Game saved successfully. See you next time!")
    else:
        print("❌ Save failed. Your progress may not be preserved.")

