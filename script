def game_loop():
    print("🌌 Initializing Seedfall RPG Engine...")
    try:
        master = get_master_json()
        state = get_game_state()
    except Exception as e:
        print(f"❌ Init failed: {e}")
        return

    engine = MechanicsEngine(master, state)

    # Run ALL 4 setup phases in strict order
    phases = [
        ('phase_0_narration', run_phase_0),
        ('phase_1_starting_point', run_phase_1),
        ('phase_2_character_build', run_phase_2),
        ('phase_3_backstory', run_phase_3)
    ]
    for phase_key, phase_func in phases:
        if state['game_state']['player']['phase_status'].get(phase_key) == 'awaiting':
            phase_func()
            state = get_game_state()
            engine = MechanicsEngine(master, state)

    # Generate opening scene if fresh start
    if state['game_state']['time_tracking']['turn'] == 0:
        generate_opening_scene(master, state)

    print("\n✅ Engine Ready. Type /help for commands.\n")

    while True:
        try:
            user_input = input("👤 YOU: ").strip()
        except (EOFError, KeyboardInterrupt):
            save_on_exit(state)
            break

        if not user_input:
            continue

        cmd = user_input.lower()

        # --- Player Commands ---
        if cmd in ['/quit', 'exit', '/exit']:
            save_on_exit(state)
            break
        if cmd == '/help':
            show_help()
            continue
        if cmd == '/status':
            p = state['game_state']['player']
            print(f"\n📊 HP: {p['vitals'].get('hp',0)}/{p['vitals'].get('max_hp',100)} | Sanity: {p['vitals'].get('sanity',0)}/{p['vitals'].get('max_sanity',100)} | H: {p['vitals'].get('hunger',0)} | T: {p['vitals'].get('thirst',0)}")
            print(f"⚡ S: {p['energy'].get('S',0)}/{p['energy'].get('max_S',100)} | Rc: {p['energy'].get('Rc',0)}/{p['energy'].get('max_Rc',100)} | M: {p['energy'].get('M',0)}/{p['energy'].get('max_M',100)}")
            print(f"📍 {p.get('location','?')} | ELQ: {p.get('current_elq',0)} | {p.get('current_weather','?')}\n")
            continue
        if cmd == '/inventory':
            show_inventory(state)
            continue
        if cmd == '/quests':
            show_quests(state)
            continue
        if cmd == '/engine':
            show_engine(state)
            continue
        if cmd == '/era':
            show_era(state)
            continue
        if cmd == '/save':
            if force_autosave(state, "manual"):
                print("💾 Saved!\n")
            continue
        if cmd == '/history':
            print("\n📜 Recent actions:")
            for h in list(conversation_history)[-6:]:
                print(f"   • {h[:100]}")
            print()
            continue

        # --- Process Narrative Action ---
        sanitized = user_input[:500]
        conversation_history.append(f"Player: {sanitized[:100]}")
        system_prompt = build_system_prompt(master, state, sanitized)

        print("🤖 ENGINE: Processing...")
        raw_ai = call_ai("narrative", system_prompt, f"Player Action: {sanitized}")

        # Validate AI output
        if not raw_ai or raw_ai == "[ENGINE ERROR: AI unavailable]":
            print("❌ AI failed to respond. Please try again.\n")
            continue

        batch = StateBatch()
        clean_narrative, feedback = parse_and_execute_ai_commands(raw_ai, engine, batch)

        if batch.changes:
            batch.commit()
            state = get_game_state()
            engine = MechanicsEngine(master, state)

        # Increment turn ONCE
        state['game_state']['time_tracking']['turn'] += 1
        current_turn = state['game_state']['time_tracking']['turn']

        # Periodic autosave
        if current_turn % AUTOSAVE_INTERVAL == 0:
            force_autosave(state, f"turn {current_turn}")
            state = get_game_state()
            engine = MechanicsEngine(master, state)

        conversation_history.append(f"Engine: {clean_narrative[:100]}")

        # --- Display Output (Tasteful Vertical Layout) ---
        if feedback:
            feedback_text = "\n".join(f"  ⚙️ {fb}" for fb in feedback)
            display_system(feedback_text)

        display_story(clean_narrative)
        display_hud(generate_hud(state))
        print()

