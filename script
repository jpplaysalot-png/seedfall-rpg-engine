def extract_backstory_to_state(player_backstory_text):
    """Uses the cheap, fast Parsing Model to extract JSON from player text."""
    system_prompt = """
    You are a data extraction engine. Read the player's backstory and extract it into the following JSON format. 
    Do not write prose. ONLY output valid JSON.
    {
      "characters_mentioned": ["Name1", "Name2"],
      "locations_mentioned": ["Place1"],
      "skills_from_background": ["Skill1"],
      "goals_generated": ["Goal1"],
      "vows_sworn": ["Vow1"],
      "traumas_applied": ["Trauma1"]
    }
    """
    
    raw_json_response = call_ai(
        "parsing",
        system_prompt,
        player_backstory_text,
        temperature_override=0.2
    )
    
    try:
        clean_text = raw_json_response.strip().strip('```json').strip('```')
        extracted_data = json.loads(clean_text)
        return extracted_data
    except json.JSONDecodeError:
        logger.error("Parsing model failed to return valid JSON.")
        return {}

