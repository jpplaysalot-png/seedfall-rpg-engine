def passive_vitals_drain(state):
    turn = state['game_state']['time_tracking']['turn']
    if turn > 0 and turn % PASSIVE_DRAIN_INTERVAL == 0:
        p = state['game_state']['player']
        p['vitals']['hunger'] = max(0, p['vitals']['hunger'] - 2)
        p['vitals']['thirst'] = max(0, p['vitals']['thirst'] - 3)
        if p.get('current_elq', 0) >= 15:
            p['vitals']['sanity'] = max(0, p['vitals']['sanity'] - 1)
        logger.info(f"⏳ Drain: H={p['vitals']['hunger']} T={p['vitals']['thirst']}")

def force_autosave(state, reason="periodic"):
    try:
        passive_vitals_drain(state)
        if save_game_state(state):
            logger.info(f"💾 Autosave ({reason})")
            return True
        return False
    except Exception as e:
        logger.error(f"Autosave failed: {e}")
        return False

def save_on_exit(state):
    print("\n💾 Saving before exit...")
    if save_game_state(state):
        print("✅ Saved. See you next time!")
    else:
        print("❌ Save failed!")

