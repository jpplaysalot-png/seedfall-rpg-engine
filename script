    if any(w in action for w in ['craft', 'build', 'make', 'combine', 'forge']):
        dynamic_rules.append(json.dumps(master_json['engine_rules']['crafting_unification']['first_principles_crafting']))
    if any(w in action for w in ['talk', 'seduce', 'persuade', 'npc', 'kiss', 'intimate', 'flirt', 'touch']):
        dynamic_rules.append(json.dumps(master_json['engine_rules']['eroge_mechanics']['prose_scaling']))
