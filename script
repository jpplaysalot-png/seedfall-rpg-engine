def get_model_for_task(task_type):
    """Returns the correct model config based on task type."""
    return MODELS.get(task_type, MODELS["narrative"])

def call_ai(task_type, system_prompt, user_prompt, temperature_override=None, max_tokens_override=None):
    """Calls the appropriate model based on task type with automatic fallback."""
    config = get_model_for_task(task_type)
    models_to_try = [config["primary"]] + config["fallbacks"]
    
    temperature = temperature_override if temperature_override is not None else config["temperature"]
    max_tokens = max_tokens_override if max_tokens_override is not None else config["max_tokens"]
    
    for attempt_model in models_to_try:
        try:
            url = "https://openrouter.ai/api/v1/chat/completions"
            headers = {
                "Authorization": f"Bearer {OPENROUTER_KEY}",
                "Content-Type": "application/json",
                "HTTP-Referer": "https://colab.research.google.com",
                "X-Title": "Seedfall RPG"
            }
            payload = {
                "model": attempt_model,
                "messages": [
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_prompt}
                ],
                "temperature": temperature,
                "max_tokens": max_tokens
            }
            
            response = robust_request('POST', url, json=payload, headers=headers)
            logger.info(f"✅ Used model: {attempt_model} for task: {task_type}")
            return response.json()['choices'][0]['message']['content']
            
        except Exception as e:
            logger.warning(f"Model {attempt_model} failed for {task_type}: {e}")
            continue
    
    logger.error(f"All models failed for task: {task_type}")
    return "[ENGINE ERROR: AI models unavailable]"

