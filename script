def extract_backstory_to_state(text):
    prompt = """Extract ONLY valid JSON from this backstory. No prose. No markdown.
{"characters_mentioned":[],"locations_mentioned":[],"skills_from_background":[],"goals_generated":[],"vows_sworn":[],"traumas_applied":[],"relationships":[],"possessions":[]}"""
    raw = call_ai("parsing", prompt, text)
    if raw == "[ENGINE ERROR: AI unavailable]":
        logger.error("AI unavailable for backstory extraction")
        return {}
    try:
        clean = re.sub(r'^```(?:json)?\s*', '', raw.strip())
        clean = re.sub(r'\s*```$', '', clean)
        start, end = clean.find('{'), clean.rfind('}') + 1
        if start >= 0 and end > start:
            return json.loads(clean[start:end])
    except json.JSONDecodeError:
        logger.error("JSON parse failed")
    return {}

