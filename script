    trauma = input("👤 TRAUMA (or 'none'): ").strip().lower()
    if trauma in ['', 'none', 'skip']: trauma = "none"

    print("\n🤖 ENGINE: Extracting mechanical elements...")
    extracted = extract_backstory_to_state(backstory)

    intimate_data = {"preferences": [], "kinks": [], "hard_limits": [], "soft_limits": [], "sensory_preferences": [], "discovered_partner_traits": []}
    if intimate:
        intimate_data["preferences"] = [x.strip() for x in intimate.split(',') if x.strip()]

    batch = StateBatch()
    batch.update('game_state.player.background', backstory)
    batch.update('game_state.player.physical_description', phys_desc)
    batch.update('game_state.player.intimate_profile', intimate_data)
    batch.update('game_state.player.backstory_extractions', extracted if extracted else {})
    batch.update('game_state.player.background_story', {"status": "complete", "reference": "MB-CHAR-BACKGROUND"})
    if trauma != "none":
        batch.update('game_state.player.traumas', [trauma])
    batch.update('game_state.player.phase_status.phase_3_backstory', 'complete')
    batch.update('game_state.player.setup_complete', True)
    batch.commit()

    archive_to_memory_bank("MB-CHAR-BACKGROUND", {
        "backstory": backstory[:500], "physical": phys_desc[:200], "trauma": trauma
    }, "Player backstory and profile", priority="permanent")
    print("✅ Phase 3 Complete! All setup finished.\n")

