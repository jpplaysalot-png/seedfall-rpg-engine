def get_game_state():
    """Fetch game state with validation."""
    url = f"https://api.jsonbin.io/v3/b/{MAIN_STATE_BIN_ID}/latest"
    headers = {"X-Master-Key": JSONBIN_KEY}
    response = robust_request('GET', url, headers=headers)
    return response.json()['record']

def save_game_state(data):
    """Save with validation and automatic backup."""
    url = f"https://api.jsonbin.io/v3/b/{MAIN_STATE_BIN_ID}"
    headers = {"X-Master-Key": JSONBIN_KEY, "Content-Type": "application/json"}
    response = robust_request('PUT', url, json=data, headers=headers)
    return response.status_code == 200

class StateBatch:
    """Batch multiple state changes into a single save."""
    def __init__(self):
        self.changes = []
        self.state = get_game_state()
    
    def update(self, path, value):
        """Queue a state update."""
        self.changes.append((path, value))
    
    def commit(self):
        """Apply all changes and save once."""
        for path, value in self.changes:
            parts = path.split('.')
            obj = self.state
            for part in parts[:-1]:
                obj = obj.setdefault(part, {})
            obj[parts[-1]] = value
        save_game_state(self.state)
        logger.info(f"Batch saved {len(self.changes)} changes")
        self.changes = []

