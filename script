def build_system_prompt(master_json, game_state, user_action):
    """Injects ONLY the relevant rules into the prompt to save tokens."""
    base = "You are the Seedfall RPG Engine. Follow MASTER RULES. Use [CALCULATE], [ROLL], [CHECK_RESOURCE], and [STATE_UPDATE] commands BEFORE narrating.\n"
    action = user_action.lower()
    rules = []
    
    if any(w in action for w in ['fight', 'attack', 'defend', 'enemy', 'combat']):
        rules.append(json.dumps(master_json['engine_rules']['game_mechanics']['blind_roll_protocol']))
    if any(w in action for w in ['craft', 'build', 'make', 'combine']):
        rules.append(json.dumps(master_json['engine_rules']['crafting_unification']['first_principles_crafting']))
    if any(w in action for w in ['talk', 'seduce', 'persuade', 'npc', 'kiss']):
        rules.append(json.dumps(master_json['engine_rules']['eroge_mechanics']['prose_scaling']))
        
    rules.append(f"CURRENT VITALS: HP={game_state['game_state']['player']['vitals']['hp']}, Sanity={game_state['game_state']['player']['vitals']['sanity']}, Rc={game_state['game_state']['player']['energy']['Rc']}")
    return base + "\n\nACTIVE RULES:\n" + "\n---\n".join(rules)

