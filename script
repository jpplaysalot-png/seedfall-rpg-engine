class MechanicsEngine:
    def __init__(self, master_json, game_state):
        self.master = master_json
        self.state = game_state

    def get_var(self, path):
        parts = path.split('.')
        val = self.state.get('game_state', {})
        for part in parts:
            if isinstance(val, dict) and part in val:
                val = val[part]
            elif isinstance(val, list) and part == 'length':
                val = len(val)
            else:
                return 0
        return val if isinstance(val, (int, float)) else 0

    # FIX #4: Check both resources dict AND inventory list
    def check_inventory(self, item_name):
        res = self.get_var(f'player.resources.{item_name}')
        if res > 0:
            return res
        carried = self.state.get('game_state', {}).get('player', {}).get('inventory', {}).get('carried', [])
        count = sum(1 for i in carried if isinstance(i, dict) and i.get('name', '').lower() == item_name.lower())
        if count == 0:
            count = sum(1 for i in carried if isinstance(i, str) and i.lower() == item_name.lower())
        return count

    def calculate(self, formula_str):
        safe_names = {
            'STR': self.get_var('player.abilities.STR'),
            'DEX': self.get_var('player.abilities.DEX'),
            'CON': self.get_var('player.abilities.CON'),
            'INT': self.get_var('player.abilities.INT'),
            'WIS': self.get_var('player.abilities.WIS'),
            'CHA': self.get_var('player.abilities.CHA'),
            'exhaustion_level': self.get_var('player.exhaustion_level'),
            'current_elq': self.get_var('player.current_elq'),
            'sanity': self.get_var('player.vitals.sanity'),
            'hp': self.get_var('player.vitals.hp'),
            'hunger': self.get_var('player.vitals.hunger'),
            'thirst': self.get_var('player.vitals.thirst'),
            'Rc': self.get_var('player.energy.Rc'),
            'S': self.get_var('player.energy.S'),
            'M': self.get_var('player.energy.M'),
            'log': math.log, 'sqrt': math.sqrt,
            'max': max, 'min': min, 'round': round, 'abs': abs
        }
        try:
            return round(simple_eval(formula_str, names=safe_names), 2)
        except Exception as e:
            logger.error(f"Formula error: {e}")
            return 0

