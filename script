# 8. DYNAMIC MECHANICS ENGINE
# ==============================================================================
class MechanicsEngine:
    def __init__(self, master_json, game_state):
        self.master = master_json
        self.state = game_state

    def get_var(self, path):
        """Safely get a nested variable from game_state."""
        parts = path.split('.')
        val = self.state['game_state']
        for part in parts:
            if isinstance(val, dict) and part in val:
                val = val[part]
            elif isinstance(val, list) and part == 'length':
                val = len(val)
            else:
                return 0
        return val if isinstance(val, (int, float)) else 0

    def calculate(self, formula_str):
        """Enhanced formula evaluation with math functions."""
        safe_names = {
            'STR': self.get_var('player.abilities.STR'),
            'DEX': self.get_var('player.abilities.DEX'),
            'CON': self.get_var('player.abilities.CON'),
            'INT': self.get_var('player.abilities.INT'),
            'WIS': self.get_var('player.abilities.WIS'),
            'CHA': self.get_var('player.abilities.CHA'),
            'exhaustion_level': self.get_var('player.exhaustion_level'),
            'current_elq': self.get_var('player.current_elq'),
            'sanity': self.get_var('player.vitals.sanity'),
            'log': math.log,
            'sqrt': math.sqrt,
            'max': max,
            'min': min,
            'round': round
        }
        
        try:
            result = simple_eval(formula_str, names=safe_names)
            return round(result, 2)
        except NameNotDefined as e:
            logger.warning(f"Missing variable in formula: {e}")
            return 0
        except Exception as e:
            logger.error(f"Formula evaluation error: {e}")
            return 0

