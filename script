def get_game_state():
    try:
        url = f"https://api.jsonbin.io/v3/b/{MAIN_STATE_BIN_ID}/latest"
        headers = {"X-Master-Key": JSONBIN_KEY}
        response = robust_request('GET', url, headers=headers)
        data = response.json()
        if 'record' not in data:
            raise Exception("Invalid response: missing 'record' key")
        return data['record']
    except Exception as e:
        logger.error(f"Failed to fetch game state: {e}")
        print(f"⚠️ Could not reach JSONBin: {e}. Retrying in 5 seconds...")
        time.sleep(5)
        return get_game_state()

def save_game_state(data):
    try:
        url = f"https://api.jsonbin.io/v3/b/{MAIN_STATE_BIN_ID}"
        headers = {"X-Master-Key": JSONBIN_KEY, "Content-Type": "application/json"}
        response = robust_request('PUT', url, json=data, headers=headers)
        return response.status_code == 200
    except Exception as e:
        logger.error(f"Failed to save game state: {e}")
        return False

class StateBatch:
    def __init__(self):
        self.changes = []
        self.state = get_game_state()

    def update(self, path, value):
        self.changes.append((path, value))

    def commit(self):
        for path, value in self.changes:
            parts = path.split('.')
            obj = self.state
            try:
                for part in parts[:-1]:
                    if isinstance(obj, dict):
                        obj = obj.setdefault(part, {})
                    else:
                        logger.warning(f"Cannot traverse path {path}: {part} is not a dict")
                        break
                if isinstance(obj, dict):
                    obj[parts[-1]] = value
            except Exception as e:
                logger.error(f"Failed to update path {path}: {e}")
        if save_game_state(self.state):
            logger.info(f"✅ Batch saved {len(self.changes)} changes")
        self.changes = []

