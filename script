# ==============================================================================
def get_memory_bank():
    """Fetch memory bank with retry logic."""
    for attempt in range(3):
        try:
            url = f"https://api.jsonbin.io/v3/b/{MEMORY_BANK_BIN_ID}/latest"
            headers = {"X-Master-Key": JSONBIN_KEY}
            response = requests.get(url, headers=headers, timeout=10)
            if response.status_code == 200:
                return response.json()['record'].get('memory_bank', {})
        except Exception as e:
            logger.warning(f"Memory bank fetch attempt {attempt+1} failed: {e}")
            if attempt < 2:
                time.sleep(2)
    return {}

def save_memory_bank(memory_bank):
    """Save memory bank back to JSONBin."""
    url = f"https://api.jsonbin.io/v3/b/{MEMORY_BANK_BIN_ID}"
    headers = {"X-Master-Key": JSONBIN_KEY, "Content-Type": "application/json"}
    payload = {"memory_bank": memory_bank}
    response = robust_request('PUT', url, json=payload, headers=headers)
    return response.status_code == 200

def prune_memory_bank(memory_bank):
    """Safely prune memory bank based on priority, protecting important data."""
    logger.info("Analyzing memory bank for safe pruning...")
    
    permanent = {k: v for k, v in memory_bank.items() if v.get('priority') == 'permanent'}
    persistent = sorted([(k, v) for k, v in memory_bank.items() if v.get('priority') == 'persistent'], 
                       key=lambda x: x[1].get('archived_at', {}).get('turn', 0))
    transient = sorted([(k, v) for k, v in memory_bank.items() if v.get('priority') == 'transient'], 
                      key=lambda x: x[1].get('archived_at', {}).get('turn', 0))
    
    pruned = {**permanent, **dict(persistent[-100:]), **dict(transient[-20:])}
    removed_count = len(memory_bank) - len(pruned)
    if removed_count > 0:
        logger.info(f"✅ Safely pruned {removed_count} low-priority entries. Protected {len(permanent)} permanent entries.")
    else:
        logger.info("✅ No pruning needed.")
        
    return pruned

def archive_to_memory_bank(code, data, summary="", priority="persistent"):
    """Smart archiving with priority-based size management."""
    logger.info(f"Archiving {code} (Priority: {priority}) to Memory Bank...")
    
    memory_bank = get_memory_bank()
    state = get_game_state()
    
    memory_bank[code] = {
        "summary": summary,
        "data": data,
        "priority": priority,
        "archived_at": state['game_state']['time_tracking']
    }
    
    bank_size = len(json.dumps(memory_bank))
    if bank_size > 400000:
        logger.warning(f"Memory bank at {bank_size} bytes, triggering safe prune...")
        memory_bank = prune_memory_bank(memory_bank)
    
    if save_memory_bank(memory_bank):
        logger.info(f"Archived {code} successfully.")
        return True
    return False

