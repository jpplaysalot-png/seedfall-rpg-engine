def call_ai(task_type, system_prompt, user_prompt, temperature_override=None, max_tokens_override=None):
    config = MODELS.get(task_type, MODELS["narrative"])
    models_to_try = [config["primary"]] + config["fallbacks"]
    temp = temperature_override if temperature_override is not None else config["temperature"]
    max_tok = max_tokens_override if max_tokens_override is not None else config["max_tokens"]

    for model in models_to_try:
        try:
            headers = {
                "Authorization": f"Bearer {OPENROUTER_KEY}",
                "Content-Type": "application/json",
                "HTTP-Referer": "https://colab.research.google.com",
                "X-Title": "Seedfall RPG"
            }
            payload = {
                "model": model,
                "messages": [
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_prompt}
                ],
                "temperature": temp,
                "max_tokens": max_tok
            }
            response = robust_request('POST', "https://openrouter.ai/api/v1/chat/completions",
                                     json=payload, headers=headers)
            logger.info(f"✅ {model} for {task_type}")
            return response.json()['choices'][0]['message']['content']
        except Exception as e:
            logger.warning(f"{model} failed: {e}")
    return "[ENGINE ERROR: AI unavailable]"

