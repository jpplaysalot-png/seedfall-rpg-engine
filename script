def game_loop():
    """Main game loop with robust autosave."""
    print("🌌 Initializing Seedfall RPG Engine...")
    master = get_master_json()
    state = get_game_state()
    engine = MechanicsEngine(master, state)
    
    # Check setup phases
    if state['game_state']['player']['phase_status']['phase_0_narration'] == 'awaiting':
        run_phase_0_setup()
        state = get_game_state()
    
    if state['game_state']['player']['phase_status']['phase_3_backstory'] == 'awaiting':
        run_phase_3_backstory()
        state = get_game_state()
    
    print("\n✅ Engine Ready. Type your action, or '/status' to check vitals, '/save' to save manually.\n")

    while True:
        user_input = input("👤 YOU: ").strip()
        
        # Handle exit with save
        if user_input.lower() in ['/quit', 'exit']:
            save_on_exit(state)
            break
            
        if user_input.lower() == '/status':
            print(json.dumps(state['game_state']['player']['vitals'], indent=2))
            continue
        
        # Handle manual save command
        if user_input.lower() == '/save':
            if force_autosave(state, reason="manual"):
                print("💾 Game saved manually!")
            continue
            
        sanitized = html.escape(user_input)[:500]
        system_prompt = build_system_prompt(master, state, sanitized)
        
        print("🤖 ENGINE: Processing...")
        raw_ai = call_ai("narrative", system_prompt, f"Player Action: {sanitized}")
        
        batch = StateBatch()
        clean_narrative, feedback = parse_and_execute_ai_commands(raw_ai, engine, batch)
        
        # Apply AI-commanded state changes
        if batch.changes:
            batch.commit()
            state = get_game_state()
        
        # ROBUST AUTOSAVE: Periodic save every N turns
        current_turn = state['game_state']['time_tracking']['turn']
        if current_turn > 0 and current_turn % AUTOSAVE_INTERVAL == 0:
            force_autosave(state, reason=f"turn {current_turn}")
            state = get_game_state()  # Refresh after autosave
            
        print("\n" + "="*70)
        for fb in feedback:
            print(fb)
        print("-" * 70)
        print(clean_narrative)
        print("="*70 + "\n")

